#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
DATA_ROOT=${XDG_DATA_HOME:-$HOME/.local/share}
BIN_ROOT=${XDG_BIN_HOME:-$HOME/.local/bin}
INSTALL_ROOT="$DATA_ROOT/link-studio"
find_python() {
  if [[ -n "${LINK_STUDIO_PYTHON:-}" ]]; then
    if ! command -v "$LINK_STUDIO_PYTHON" >/dev/null 2>&1; then
      printf 'Python interpreter specified by LINK_STUDIO_PYTHON not found: %s\n' "$LINK_STUDIO_PYTHON" >&2
      exit 1
    fi
    command -v "$LINK_STUDIO_PYTHON"
    return 0
  fi

  for candidate in python3.14 python3.13 python3.12 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      if "$candidate" -c 'import sys, gi; sys.exit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
        command -v "$candidate"
        return 0
      fi
    fi
  done

  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return 0
    fi
  done

  printf 'Link Studio requires Python >= 3.12 and the system GTK bindings (python-gobject / gi), but no Python interpreter was found.\n' >&2
  exit 1
}

SYSTEM_PYTHON=$(find_python)

if ! "$SYSTEM_PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
  current_version=$("$SYSTEM_PYTHON" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")' 2>/dev/null || echo "unknown")
  printf 'Link Studio requires Python >= 3.12 (found Python %s at %s).\n' "$current_version" "$SYSTEM_PYTHON" >&2
  exit 1
fi

if ! "$SYSTEM_PYTHON" -c 'import gi' >/dev/null 2>&1; then
  printf 'Link Studio requires the system GTK bindings (python-gobject / gi).\n' >&2
  exit 1
fi

if command -v uv >/dev/null 2>&1; then
  uv venv --clear --python "$SYSTEM_PYTHON" --system-site-packages --seed \
    "$INSTALL_ROOT/venv"
  uv pip install --python "$INSTALL_ROOT/venv/bin/python" --upgrade "$PROJECT_DIR"
else
  "$SYSTEM_PYTHON" -m venv --clear --system-site-packages "$INSTALL_ROOT/venv"
  "$INSTALL_ROOT/venv/bin/python" -m ensurepip --upgrade
  "$INSTALL_ROOT/venv/bin/python" -m pip install --upgrade "$PROJECT_DIR"
fi

install -Dm644 "$PROJECT_DIR/data/io.github.linkstudio.LinkStudio.desktop" \
  "$DATA_ROOT/applications/io.github.linkstudio.LinkStudio.desktop"
install -Dm644 "$PROJECT_DIR/data/io.github.linkstudio.LinkStudio.metainfo.xml" \
  "$DATA_ROOT/metainfo/io.github.linkstudio.LinkStudio.metainfo.xml"
for icon in \
  "$PROJECT_DIR"/data/icons/hicolor/*/apps/io.github.linkstudio.LinkStudio.png; do
  size=$(basename "$(dirname "$(dirname "$icon")")")
  install -Dm644 "$icon" \
    "$DATA_ROOT/icons/hicolor/$size/apps/io.github.linkstudio.LinkStudio.png"
done
mkdir -p "$BIN_ROOT"
ln -sfn "$INSTALL_ROOT/venv/bin/link-studio" "$BIN_ROOT/link-studio"
install -Dm755 "$PROJECT_DIR/scripts/setup-virtual-camera" \
  "$BIN_ROOT/link-studio-setup-virtual-camera"
install -Dm755 "$PROJECT_DIR/scripts/setup-local-ai" \
  "$BIN_ROOT/link-studio-setup-local-ai"

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$DATA_ROOT/applications"
fi

printf 'Installed Link Studio. Run: %s/link-studio\n' "$BIN_ROOT"
